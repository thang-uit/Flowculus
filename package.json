{
  "name": "flowculus",
  "version": "0.1.0",
  "private": true,
  "description": "A fast cycle-time workspace for process models.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@flowculus/web",
    "build": "turbo run build --filter=@flowculus/web",
    "start": "pnpm --filter @flowculus/web start",
    "clean:cache": "node scripts/clean-cache.mjs",
    "lint": "turbo run lint --filter=@flowculus/web",
    "graph:index": "gitnexus analyze --index-only --pdg --workers 2",
    "graph:check": "gitnexus check --cycles -r Flowculus",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run test && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build",
    "dev:web": "pnpm --filter @flowculus/web dev",
    "demo:export": "node scripts/export-study-kit.mjs",
    "demo:export:small-fixture": "node scripts/export-demo-kit.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.10.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
